    {
      "id": "geoai-short.tiktok",
      "owner_account_id": "personal",
      "source_connection_id": "personal.youtube",
      "destination_connection_id": "dept.tiktok",
      "trigger": {
        "any": [
          {
            "field": "phase",
            "op": "eq",
            "value": "uploaded"
          },
          {
            "field": "phase",
            "op": "eq",
            "value": "scheduled"
          },
          {
            "field": "phase",
            "op": "eq",
            "value": "published"
          }
        ]
      },
      "allowed_slots": [],
      "transform_id": "geoai-short.tiktok",
      "delivery_owner": "legacy",
      "enabled": true,
      "activation_evidence": [
        {
          "kind": "config",
          "key": "tiktok_web.daily",
          "value": true
        },
        {
          "kind": "config",
          "key": "tiktok.enabled",
          "value": false
        },
        {
          "kind": "installed_plist",
          "key": "tiktok_queue",
          "present": false,
          "loaded": null,
          "disabled": null
        },
        {
          "kind": "automation_note",
          "key": "tiktok_web.daily",
          "value": false,
          "stale": true
        },
        {
          "kind": "code",
          "path": "dept/youtube-shorts-auto/tiktok_queue.py",
          "symbol": "add",
          "delay_seconds": 1800
        }
      ],
      "delay_seconds": 1800,
      "delay_owner": "legacy_queue_add",
      "min_gap_seconds": 10800,
      "window": {
        "start": "07:00",
        "end": "23:00",
        "timezone": "Asia/Seoul"
      },
      "dedupe_strategy": "legacy_video_path",
      "conditions": {
        "all": [
          {
            "field": "caller",
            "op": "eq",
            "value": "geoai_short"
          },
          {
            "field": "upload_response",
            "op": "eq",
            "value": true
          },
          {
            "field": "channel_ok",
            "op": "eq",
            "value": true
          }
        ]
      },
      "queue_source": "geoai_short",
      "ai_generated": true,
      "ai_voice": true,
      "source_time_basis": "youtube_scheduled_at_or_upload_at",
      "failure_independent_of_source": true,
      "queue_constraints": {
        "max_age_days": 14,
        "max_tries": 5,
        "excluded_states": [
          "skipped",
          "posted"
        ],
        "requires_video_exists": true,
        "hold_until": true,
        "ordering": [
          "new_before_backfill",
          "priority",
          "not_before"
        ],
        "backfill_quiet_seconds": 10800,
        "infrastructure_error_increments_tries": false,
        "repeated_screen_error_hold": {
          "count": 2,
          "until": "next_midnight"
        }
      }
    },
